NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Adzuna (free key at developer.adzuna.com). Leave empty to use built-in sample jobs.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Teammates' FastAPI service (members 2, 3, 4). Leave empty to use mock data / local fallbacks.
AI_BACKEND_URL=
# Optional shared secret. If you set BACKEND_API_KEY on the backend, put the same value here.
AI_BACKEND_KEY=
